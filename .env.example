# Get API credentials from https://my.telegram.org.
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:telegram_bot_token
# Generate this locally with python generate_session.py, then store it in Render env vars.
SESSION_STRING=your_exported_pyrogram_session_string
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DATABASE=telegram_automation
LOG_LEVEL=INFO
DEFAULT_SEND_DELAY=0.5
USER_SESSION_NAME=user_session
BOT_SESSION_NAME=bot_session
MAX_CONCURRENT_SENDS=5
